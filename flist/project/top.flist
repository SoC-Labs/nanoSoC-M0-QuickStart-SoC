//-----------------------------------------------------------------------------
// nanoSoC-M0 QuickStart — top-level filelist
//
// Copyright (C) 2026, SoC Labs (www.soclabs.org)
//-----------------------------------------------------------------------------
// One chain. The Arm IP roots come from nanosoc.config via ARM_CORTEX_M0_DIR and
// ARM_CORSTONE_101_DIR — there is no _qs variant to choose between.
//-----------------------------------------------------------------------------

// DESIGN_TOP nanosoc_chip

// ============= Verilog library extensions ===========
+libext+.v+.vlib

// =============    Project defines      =========================
+incdir+$(SOCLABS_PROJECT_DIR)/system/src/defines

// =============    Testbench            =========================
-f $(SOCLABS_NANOSOC_ARCH_TECH_DIR)/rtl/flist/nanosoc_tb.flist

// =============    Generic Library      =========================
// - Pad cells, synchronisers
-f $(SOCLABS_GENERIC_LIB_TECH_DIR)/flist/generic_lib_ip.flist

// =============    FPGA Memory Models   =========================
// - AHB SRAM and ROM simulation models
-f $(SOCLABS_FPGA_LIB_TECH_DIR)/flist/fpga_lib_mem_ip.flist

// =============    Generated Files      =========================
// - Bootrom (generated by `make bootrom` — stage0 bootloader)
$(SOCLABS_PROJECT_DIR)/build/firmware/bootloader/stage0/out/bootrom.sv

// =============    NanoSoC Design       =========================
-f $(SOCLABS_NANOSOC_ARCH_TECH_DIR)/rtl/flist/nanosoc.flist
