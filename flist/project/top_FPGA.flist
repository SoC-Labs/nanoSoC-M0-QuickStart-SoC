//-----------------------------------------------------------------------------
// nanoSoC-M0 QuickStart — FPGA design filelist
//
// Copyright (C) 2026, SoC Labs (www.soclabs.org)
//-----------------------------------------------------------------------------
// Design sources only — no testbench. Consumed by flows/makefile.fpga:72 via
// filelist_compile.py, which compiles this into a Tcl filelist and copies the
// sources into the implementation tree.
//
// Referenced by arch_tech makefile:247 as DESIGN_VC_FPGA. Without this file no
// FPGA target builds, on any board.
//-----------------------------------------------------------------------------

// DESIGN_TOP nanosoc_chip

// ============= Verilog library extensions ===========
+libext+.v+.vlib

// =============    Project defines      =========================
+incdir+$(SOCLABS_PROJECT_DIR)/system/src/defines

// =============    Generic Library      =========================
// - Pad cells, synchronisers
-f $(SOCLABS_GENERIC_LIB_TECH_DIR)/flist/generic_lib_ip.flist

// =============    FPGA Memory Models   =========================
-f $(SOCLABS_FPGA_LIB_TECH_DIR)/flist/fpga_lib_mem_ip.flist

// =============    Generated Files      =========================
// - Bootrom (generated by `make bootrom` — stage0 bootloader)
$(SOCLABS_PROJECT_DIR)/build/firmware/bootloader/stage0/out/bootrom.sv

// =============    NanoSoC Design       =========================
-f $(SOCLABS_NANOSOC_ARCH_TECH_DIR)/rtl/flist/nanosoc_FPGA.flist
