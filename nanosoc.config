#-----------------------------------------------------------------------------
# nanoSoC-M0 QuickStart — project configuration
#
# Copyright (C) 2026, SoC Labs (www.soclabs.org)
#-----------------------------------------------------------------------------
# This project builds with Arm Quickstart IP only. There is no AAA path and no
# QUICKSTART switch: set ARM_QS_IP_DIR to wherever you unpacked your Cortex-M0
# Quickstart download and everything else follows.
#
# ARM_QS_IP_DIR must contain:
#   Cortex-M0-logical/     cortexm0, cortexm0_dap, cortexm0_integration, models
#   Corstone-101-logical/  the CMSDK peripherals and bus infrastructure
#-----------------------------------------------------------------------------

ARM_QS_IP_DIR        ?= $(ARM_IP_LIBRARY_PATH)/latest/Cortex-M0-QS

ARM_CORTEX_M0_DIR    ?= $(ARM_QS_IP_DIR)/Cortex-M0-logical
ARM_CORSTONE_101_DIR ?= $(ARM_QS_IP_DIR)/Corstone-101-logical

# Boot ROM size, in the firmware flow's units.
#
# This number exists TWICE and the two copies had diverged 8x:
#   RTL   build_soc/rtl/nanosoc_soc_config_pkg.sv:34  BOOTROM_ADDR_W = 11  -> 8 KB
#   flow  nanosoc_arch_tech/flows/Makefile.bootrom:35 BOOTROM_ADDRW ?= 8   -> 1 KB
# Both mean "phys bytes = 4 * 2^N"; note the names differ only by an underscore.
# stage0 is ~2000 bytes since QSPI XiP boot landed, so bootrom_gen refused it
# against its own 1 KB figure while the RTL ROM it targets is 8 KB.
# Track the RTL. The flow default is left alone because it is shared with the
# AAA project, whose stage0 is smaller and does not hit the limit.
BOOTROM_ADDRW := 11
# Must be EXPORTED, not just set. The `bootrom` target recurses with
# `make -f flows/Makefile.bootrom`, a standalone makefile that never includes
# this file and passes through only SIM_TOP_DIR and TESTCODES_DIR. Exporting puts
# the value in the sub-make's environment, where `?=` cannot override it.
export BOOTROM_ADDRW
